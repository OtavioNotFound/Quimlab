# QuimLab — Configuração de Variáveis de Ambiente
# Duplique este arquivo como .env e preencha com as credenciais do seu projeto Supabase.

# URL do projeto Supabase (disponível em Project Settings > API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima pública (anon key) do Supabase (segura para uso no cliente frontend)
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
